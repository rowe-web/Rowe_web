# =============================================================================
# ROWE · Variables de entorno
# Copia este archivo como .env.local y rellénalo. NUNCA subas .env.local a git.
# Las variables NEXT_PUBLIC_* son visibles en el navegador: no pongas secretos ahí.
# =============================================================================

# --- Sitio -------------------------------------------------------------------
# URL pública de la web, SIN barra final. Ahora localhost; el día del lanzamiento,
# tu dominio (https://rowe-web.es). De aquí salen canonical, sitemap, robots y OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Interruptor de indexación en Google. Déjalo en false hasta el lanzamiento:
# con false la web sale con noindex y robots.txt bloquea a los buscadores.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Supabase (Project Settings → API Keys) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave «publishable» (sb_publishable_…) o, en proyectos antiguos, la «anon key».
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave «secret» (sb_secret_…) o, en proyectos antiguos, la «service_role key».
# SOLO servidor. Da acceso total: no la compartas ni la pongas en NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=

# Conexión a Postgres para migraciones y seed: botón Connect → «Session pooler».
# NO uses la conexión directa (db.xxx.supabase.co): solo funciona con IPv6.
# Si la contraseña tiene símbolos, codifícalos: ? → %3F  # → %23  / → %2F  @ → %40  : → %3A
# Formato: postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-1-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Usuario administrador inicial (lo crea `npm run db:seed`) ----------------
SEED_ADMIN_EMAIL=rowe.web.agency@gmail.com
# Mínimo 12 caracteres. Podrás cambiarla después desde el panel.
SEED_ADMIN_PASSWORD=

# --- Email de avisos de nuevo lead --------------------------------------------
# Sin dominio propio: Gmail con «contraseña de aplicación» (ver README → Email).
# Si no se configura, los leads se guardan igual y el aviso queda en cola para reintentarlo.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=rowe.web.agency@gmail.com
# Contraseña de aplicación de Google (16 letras, sin espacios), NO la contraseña de la cuenta.
SMTP_PASSWORD=
# Remitente que verá el equipo (opcional). Con Gmail debe ser la propia cuenta.
EMAIL_FROM=ROWE Web <rowe.web.agency@gmail.com>
# Con dominio propio (la solución de fondo contra el spam): EMAIL_PROVIDER=resend + RESEND_API_KEY
# + EMAIL_FROM="ROWE <hola@tu-dominio>". Antes hay que verificar el dominio en Resend (registros
# SPF, DKIM y DMARC en el DNS). Resend no permite enviar como @gmail.com: sin dominio, Gmail SMTP.
# RESEND_API_KEY=

# --- Seguridad de tareas y anonimización -----------------------------------------
# Secreto de la tarea programada que reintenta los emails (texto largo y aleatorio).
CRON_SECRET=
# Sal para anonimizar las IPs en el límite de envíos (texto aleatorio).
IP_HASH_SALT=

# --- Otros ---------------------------------------------------------------------
# Muestra la guía de estilo (/sistema) también en producción.
# ENABLE_STYLEGUIDE=true

# Datos legales del titular (npm run db:legal los guarda en el borrador; aquí no en el repositorio)
LEGAL_OWNER=
LEGAL_NIF=
LEGAL_ADDRESS=
LEGAL_EMAIL=
# Opcional, cuando se confirme el alojamiento
LEGAL_HOSTING=
